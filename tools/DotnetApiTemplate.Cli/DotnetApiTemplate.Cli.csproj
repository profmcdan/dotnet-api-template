<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)../../Directory.Packaging.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DotnetApiTemplate.Cli</RootNamespace>
    <AssemblyName>dotnet-api-template</AssemblyName>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-api-template</ToolCommandName>
    <PackageId>$(PackageIdPrefix).Cli</PackageId>
    <Title>dotnet-api-template</Title>
    <Description>CLI that scaffolds a clean-architecture ASP.NET Core Web API with JWT user management, an invite-by-email flow over Kafka, a transactional outbox, EF Core on PostgreSQL, Redis, a migrator job, background workers and Docker Compose. The project template ships inside the tool.</Description>
    <PackageTags>dotnet-new;template;scaffold;clean-architecture;webapi;cqrs;kafka;postgres;redis;docker</PackageTags>

    <!-- Keep `info` and `version` readable; the commit hash belongs in the package metadata. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- The tool is a developer utility, not part of the generated application. -->
    <NoWarn>$(NoWarn);CA1303;CA1031;CA2000</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="../../LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    The tool carries the template with it, so `dotnet tool install` is the only step a user needs.
    The payload itself is defined once, in Directory.Packaging.props.
  -->
  <ItemGroup>
    <Content Include="@(TemplatePayload)"
             TargetPath="template\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Pack="false" />
  </ItemGroup>

</Project>
