# ---------------------------------------------------------------------------------------------
# Copy to .env and adjust. Compose loads it via env_file; `dotnet run` picks it up through the
# DotEnv loader in CleanArchTemplate.Infrastructure.
#
# Keys use the ASP.NET Core convention: Section__Key maps onto configuration "Section:Key", and a
# real environment variable always beats the value here.
#
# NEVER commit a filled-in .env - it is git-ignored for a reason.
# ---------------------------------------------------------------------------------------------

# --- Compose ---------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=cleanarch
API_HTTP_PORT=5080
WORKER_HTTP_PORT=5081
POSTGRES_PORT=5432
REDIS_PORT=6379
REDPANDA_KAFKA_PORT=19092
REDPANDA_CONSOLE_PORT=8085
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Runtime ---------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# --- Application -----------------------------------------------------------------------------
APP__NAME=CleanArchTemplate
# Public address of your front end. Every link in an outbound email is built from this, never
# from an inbound Host header.
APP__PUBLICBASEURL=http://localhost:5173
APP__ACCEPTINVITATIONPATH=/accept-invitation
APP__SIGNINPATH=/sign-in
APP__SUPPORTURL=mailto:support@example.com

# --- Postgres --------------------------------------------------------------------------------
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me-in-production
# Host name `postgres` resolves on the compose network; use localhost when running outside Docker.
DATABASE__CONNECTIONSTRING=Host=postgres;Port=5432;Database=appdb;Username=appuser;Password=change-me-in-production;Include Error Detail=true
DATABASE__COMMANDTIMEOUTSECONDS=30
DATABASE__MAXRETRYCOUNT=5
DATABASE__ENABLESENSITIVEDATALOGGING=false
DATABASE__ENABLEDETAILEDERRORS=true

# --- Redis -----------------------------------------------------------------------------------
REDIS__CONNECTIONSTRING=redis:6379
REDIS__INSTANCENAME=cleanarch
REDIS__DEFAULTTTLSECONDS=300

# --- Kafka / Redpanda ------------------------------------------------------------------------
KAFKA__BOOTSTRAPSERVERS=redpanda:9092
# Prepended to every topic name, so several environments can share one broker.
# The migrator creates topics under this prefix; the API and worker read and write under it.
KAFKA__TOPICPREFIX=cleanarch
KAFKA__CONSUMERGROUPID=cleanarch-workers
KAFKA__SECURITYPROTOCOL=Plaintext
KAFKA__DEFAULTPARTITIONS=3
KAFKA__DEFAULTREPLICATIONFACTOR=1
KAFKA__MAXDELIVERYATTEMPTS=5
KAFKA__VALIDATETOPICSONSTART=true

# --- JWT -------------------------------------------------------------------------------------
JWT__ISSUER=cleanarch-template
JWT__AUDIENCE=cleanarch-template-clients
# MUST be at least 32 characters. Generate one with:  openssl rand -base64 48
JWT__SIGNINGKEY=replace-this-with-a-real-secret-at-least-32-chars-long
JWT__ACCESSTOKENMINUTES=15
JWT__REFRESHTOKENDAYS=14

# --- Email (Mailpit catches everything locally; nothing leaves the machine) --------------------
EMAIL__SMTPHOST=mailpit
EMAIL__SMTPPORT=1025
EMAIL__SECURESOCKETOPTIONS=None
EMAIL__FROMADDRESS=no-reply@example.com
EMAIL__FROMDISPLAYNAME=CleanArchTemplate
# EMAIL__USERNAME=
# EMAIL__PASSWORD=

# --- Invitations & security ------------------------------------------------------------------
INVITATIONS__LIFETIMEDAYS=7
SECURITY__MAXFAILEDLOGINATTEMPTS=10
SECURITY__LOCKOUTWINDOWMINUTES=15

# --- Outbox ----------------------------------------------------------------------------------
OUTBOX__BATCHSIZE=100
OUTBOX__POLLINTERVALSECONDS=5
OUTBOX__MAXATTEMPTS=8
OUTBOX__RETENTIONDAYS=7

# --- Migrator: bootstrap administrator -------------------------------------------------------
# Created only when the users table is empty. Sign in with these, invite real users, then remove.
MIGRATOR__SEEDADMINEMAIL=admin@example.com
MIGRATOR__SEEDADMINPASSWORD=change-me-immediately-1
MIGRATOR__SEEDADMINNAME=Administrator
MIGRATOR__STARTUPTIMEOUTSECONDS=120

# --- CORS (comma-free: one indexed key per origin) -------------------------------------------
CORS__ALLOWEDORIGINS__0=http://localhost:5173
CORS__ALLOWEDORIGINS__1=http://localhost:3000

# --- Observability ---------------------------------------------------------------------------
# Leave empty to disable OTLP export; no collector is required for local development.
OTLP__ENDPOINT=
