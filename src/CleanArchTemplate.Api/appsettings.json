{
  "App": {
    "Name": "CleanArchTemplate",
    "PublicBaseUrl": "http://localhost:5173",
    "AcceptInvitationPath": "/accept-invitation",
    "SignInPath": "/sign-in",
    "SupportUrl": "mailto:support@example.com"
  },
  "Database": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 5,
    "EnableSensitiveDataLogging": false,
    "EnableDetailedErrors": false
  },
  "Kafka": {
    "BootstrapServers": "localhost:19092",
    "TopicPrefix": "cleanarch",
    "ConsumerGroupId": "cleanarch-workers",
    "SecurityProtocol": "Plaintext",
    "DefaultPartitions": 3,
    "DefaultReplicationFactor": 1,
    "SessionTimeoutMs": 45000,
    "MaxDeliveryAttempts": 5,
    "ValidateTopicsOnStart": true
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "cleanarch",
    "DefaultTtlSeconds": 300
  },
  "Jwt": {
    "Issuer": "cleanarch-template",
    "Audience": "cleanarch-template-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "ClockSkewSeconds": 30
  },
  "Email": {
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "SecureSocketOptions": "None",
    "FromAddress": "no-reply@example.com",
    "FromDisplayName": "CleanArchTemplate",
    "TimeoutSeconds": 30
  },
  "Invitations": {
    "LifetimeDays": 7
  },
  "Security": {
    "MaxFailedLoginAttempts": 10,
    "LockoutWindowMinutes": 15
  },
  "Outbox": {
    "BatchSize": 100,
    "PollIntervalSeconds": 5,
    "MaxAttempts": 8,
    "RetentionDays": 7
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*"
}
